CIVICFIX_PRIMARY.ENV="local"

CIVICFIX_SERVER.PORT="8080"
CIVICFIX_SERVER.READ_TIMEOUT="30"
CIVICFIX_SERVER.WRITE_TIMEOUT="30"
CIVICFIX_SERVER.IDLE_TIMEOUT="60"
# Comma-separated exact origins (no wildcards), e.g. "http://localhost:5173,https://your-app.vercel.app"
CIVICFIX_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:5173"

CIVICFIX_DATABASE.HOST="localhost"
CIVICFIX_DATABASE.PORT="5432"
CIVICFIX_DATABASE.USER="postgres"
CIVICFIX_DATABASE.PASSWORD=""
CIVICFIX_DATABASE.NAME="civicfix"
CIVICFIX_DATABASE.SSL_MODE="disable"
CIVICFIX_DATABASE.MAX_OPEN_CONNS="25"
CIVICFIX_DATABASE.MAX_IDLE_CONNS="25"
CIVICFIX_DATABASE.CONN_MAX_LIFETIME="300"
CIVICFIX_DATABASE.CONN_MAX_IDLE_TIME="300"

CIVICFIX_AUTH.SECRET_KEY="secret"
# Comma-separated emails that become admin at onboarding (bootstraps the first admin)
CIVICFIX_AUTH.BOOTSTRAP_ADMIN_EMAILS=""

CIVICFIX_INTEGRATION.RESEND_API_KEY="resend_key"
CIVICFIX_INTEGRATION.CLOUDINARY_CLOUD_NAME=""
CIVICFIX_INTEGRATION.CLOUDINARY_API_KEY=""
CIVICFIX_INTEGRATION.CLOUDINARY_API_SECRET=""

CIVICFIX_REDIS.ADDRESS="localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
CIVICFIX_OBSERVABILITY.SERVICE_NAME="civicfix"
CIVICFIX_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
CIVICFIX_OBSERVABILITY.LOGGING.LEVEL="debug"
CIVICFIX_OBSERVABILITY.LOGGING.FORMAT="console"
CIVICFIX_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
CIVICFIX_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CIVICFIX_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
CIVICFIX_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
CIVICFIX_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
CIVICFIX_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
CIVICFIX_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
CIVICFIX_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
CIVICFIX_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"