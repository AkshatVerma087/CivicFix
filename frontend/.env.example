# Copy to .env (git-ignored) and fill in.

# Login system:
#   legacy = email/password via the Node backend (default)
#   clerk  = Clerk sign-in via the Go backend (also point VITE_API_URL at the Go API)
VITE_AUTH_PROVIDER=legacy

# Backend base URL.
#   legacy default: http://localhost:3000/api   (Node)
#   clerk default:  http://localhost:8080/api/v1 (Go)
# VITE_API_URL=

# Clerk Publishable key: Clerk Dashboard > Configure > API keys > Publishable key (pk_test_ / pk_live_).
# Must come from the same Clerk application as the backend's CIVICFIX_AUTH.SECRET_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
